name = "manual-approval-for-prod-deploy"
violation_action = "block"

conditions {
    rego = <<-EOT
            package manual_approval_for_prod_deploy

            # Default: Deny — payment-gateway must include a manual intervention step
            # in its deployment process before reaching Cloud-Prod. Compliance can
            # come from an inline Octopus.Manual step OR from consuming a hub
            # template that provides one.
            default result := {"allowed": false, "reason": "payment-gateway deployments to Cloud-Prod must include a manual intervention (approval) step. Add an Octopus.Manual action inline, OR consume the governed-cloud-prod-deploy hub template which provides one."}

            # Whitelist: hub templates that include a manual approval step.
            approval_templates := {"governed-cloud-prod-deploy"}

            # Helper: True if any inline manual intervention step is in the skipped list
            manual_intervention_skipped if {
                some step in input.Steps
                step.Id in input.SkippedSteps
                step.ActionType == "Octopus.Manual"
            }

            # Allow: an inline manual intervention step exists and isn't being skipped
            result := {"allowed": true} if {
                some step in input.Steps
                step.ActionType == "Octopus.Manual"
                not manual_intervention_skipped
            }

            # Allow: consuming a hub template that provides the approval step
            result := {"allowed": true} if {
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId in approval_templates
                not step.Id in input.SkippedSteps
            }

            # Deny if every inline manual intervention is being skipped
            result := {
                "allowed": false,
                "reason": "Manual intervention steps cannot be skipped on Cloud-Prod deployments for payment-gateway.",
            } if {
                manual_intervention_skipped
            }
            EOT
}

scope {
    rego = <<-EOT
            package manual_approval_for_prod_deploy

            # Policy applies only to payment-gateway deployments into Cloud-Prod.
            # Other projects in the space (holiday-promo-blitz, customer-mobile-app,
            # loyalty-rewards-service, crusty-croissant-pos, pci-card-data-vault)
            # are out of scope for this specific policy.
            default evaluate := false

            evaluate if {
                input.Project.Slug == "payment-gateway"
                input.Environment.Name == "Cloud-Prod"
            }
            EOT
}
