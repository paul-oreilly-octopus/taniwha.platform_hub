name = "gdpr-step-for-emea-tenants"
violation_action = "block"

conditions {
    rego = <<-EOT
            package gdpr_step_for_emea_tenants

            # Default: Deny — crusty-croissant-pos deployments to EMEA-tagged
            # tenants must include a GDPR data-residency check step. Compliance
            # can come from either an inline step with 'GDPR' in the name OR
            # from consuming a hub template that provides one.
            default result := {"allowed": false, "reason": "Deployments of crusty-croissant-pos to EMEA-region tenants must include a GDPR data-residency check. Add an inline step whose name contains 'GDPR', OR consume the eu-region-deploy hub template which provides one."}

            # Whitelist: hub templates that include a GDPR data-residency step.
            gdpr_templates := {"eu-region-deploy"}

            # Allow: an inline step whose name contains 'GDPR'
            result := {"allowed": true} if {
                some step in input.Steps
                contains(step.Name, "GDPR")
                not step.Id in input.SkippedSteps
            }

            # Allow: consuming a hub template that provides the GDPR check
            result := {"allowed": true} if {
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId in gdpr_templates
                not step.Id in input.SkippedSteps
            }
            EOT
}

scope {
    rego = <<-EOT
            package gdpr_step_for_emea_tenants

            # Applies to crusty-croissant-pos when deploying to a tenant tagged
            # Region/EMEA. The acquired Crusty-Croissant-DE-Berlin tenant
            # carries this tag automatically; native EMEA markets (e.g.
            # MMI-UK-London) would also be in scope if they were ever connected
            # to crusty-croissant-pos.
            default evaluate := false

            evaluate if {
                input.Project.Slug == "crusty-croissant-pos"
                "Region/EMEA" in input.Tenant.Tags
            }
            EOT
}
