name = "mandatory-security-scan"
violation_action = "block"

conditions {
    rego = <<-EOT
            package mandatory_security_scan

            # Default: Deny — customer-mobile-app must include a security scan step
            # before promoting to Cloud-Prod. Compliance can come from either an
            # inline step named '...Security Scan...' OR from consuming a hub
            # process template that's known to include the scan.
            default result := {"allowed": false, "reason": "customer-mobile-app requires a security scan before Cloud-Prod. Add an inline step whose name contains 'Security Scan', OR consume a hub template that provides one (e.g. governed-customer-app-deploy)."}

            # Whitelist: hub process templates that include a security scan.
            # Template internals aren't visible to the policy engine (Source.SlugOrId
            # is all that's exposed), so we maintain this list explicitly.
            security_scan_templates := {"governed-customer-app-deploy"}

            # Allow: an inline step with 'Security Scan' in the name
            result := {"allowed": true} if {
                some step in input.Steps
                contains(step.Name, "Security Scan")
                not step.Id in input.SkippedSteps
            }

            # Allow: consuming a whitelisted hub template that provides the scan
            result := {"allowed": true} if {
                some step in input.Steps
                step.Source.Type == "Process Template"
                step.Source.SlugOrId in security_scan_templates
                not step.Id in input.SkippedSteps
            }
            EOT
}

scope {
    rego = <<-EOT
            package mandatory_security_scan

            # Applies to customer-mobile-app at the Test environment — scan must
            # be present before promotion past Test (and onwards to Cloud-Prod
            # and Markets).
            default evaluate := false

            evaluate if {
                input.Project.Slug == "customer-mobile-app"
                input.Environment.Name == "Test"
            }
            EOT
}
